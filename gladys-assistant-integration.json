{
  "manifest_version": 1,
  "type": "device",
  "name": "ORES",
  "description": {
    "en": "ORES (Wallonia) network status: outages and planned works at your address.",
    "fr": "Statut du réseau ORES (Wallonie) : pannes et travaux planifiés à votre adresse.",
    "de": "ORES-Netzstatus (Wallonien): Störungen und geplante Arbeiten an Ihrer Adresse.",
    "es": "Estado de la red ORES (Valonia): averías y trabajos previstos en su dirección."
  },
  "version": "0.0.0",
  "docker_image": "ghcr.io/gboulvin/gladys-ores:0.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/gboulvin/Gladys-ORES/main/cover.png",
  "categories": ["energy", "services"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your address on the ORES network",
        "fr": "Votre adresse sur le réseau ORES",
        "de": "Ihre Adresse im ORES-Netz",
        "es": "Su dirección en la red ORES"
      },
      "description": {
        "en": "The integration reads the public ORES outage map every few minutes and watches the address below. Only the zip code is required: add the street (and the house number) to know whether YOUR home is impacted, not only your municipality. Unofficial integration, not affiliated with ORES.",
        "fr": "L'intégration lit la carte publique des pannes ORES toutes les quelques minutes et surveille l'adresse ci-dessous. Seul le code postal est obligatoire : ajoutez la rue (et le numéro) pour savoir si VOTRE logement est touché, et pas seulement votre commune. Intégration non officielle, sans lien avec ORES.",
        "de": "Die Integration liest alle paar Minuten die öffentliche ORES-Störungskarte und überwacht die untenstehende Adresse. Nur die Postleitzahl ist erforderlich: Geben Sie die Straße (und die Hausnummer) an, um zu wissen, ob IHR Zuhause betroffen ist, nicht nur Ihre Gemeinde. Inoffizielle Integration, nicht mit ORES verbunden.",
        "es": "La integración lee el mapa público de averías de ORES cada pocos minutos y vigila la dirección indicada. Solo el código postal es obligatorio: añada la calle (y el número) para saber si SU vivienda está afectada, y no solo su municipio. Integración no oficial, sin relación con ORES."
      },
      "links": [
        {
          "url": "https://www.ores.be/pannes-et-interruptions/",
          "label": {
            "en": "ORES outages and interruptions",
            "fr": "Pannes et interruptions ORES",
            "de": "ORES-Störungen und Unterbrechungen",
            "es": "Averías e interrupciones ORES"
          }
        }
      ]
    },
    {
      "key": "zip_code",
      "type": "string",
      "label": {
        "en": "Zip code",
        "fr": "Code postal",
        "de": "Postleitzahl",
        "es": "Código postal"
      },
      "placeholder": {
        "en": "e.g. 5000",
        "fr": "ex. 5000",
        "de": "z. B. 5000",
        "es": "p. ej. 5000"
      },
      "required": true
    },
    {
      "key": "city",
      "type": "string",
      "label": {
        "en": "Locality (optional)",
        "fr": "Localité (facultatif)",
        "de": "Ortschaft (optional)",
        "es": "Localidad (opcional)"
      },
      "description": {
        "en": "Only when several localities share your zip code.",
        "fr": "Uniquement si plusieurs localités partagent votre code postal.",
        "de": "Nur wenn sich mehrere Ortschaften Ihre Postleitzahl teilen.",
        "es": "Solo si varias localidades comparten su código postal."
      },
      "placeholder": {
        "en": "e.g. Jambes",
        "fr": "ex. Jambes",
        "de": "z. B. Jambes",
        "es": "p. ej. Jambes"
      },
      "required": false
    },
    {
      "key": "street",
      "type": "string",
      "label": {
        "en": "Street (optional)",
        "fr": "Rue (facultatif)",
        "de": "Straße (optional)",
        "es": "Calle (opcional)"
      },
      "placeholder": {
        "en": "e.g. Rue de Fer",
        "fr": "ex. Rue de Fer",
        "de": "z. B. Rue de Fer",
        "es": "p. ej. Rue de Fer"
      },
      "required": false
    },
    {
      "key": "house_number",
      "type": "string",
      "label": {
        "en": "House number (optional)",
        "fr": "Numéro (facultatif)",
        "de": "Hausnummer (optional)",
        "es": "Número (opcional)"
      },
      "placeholder": { "en": "e.g. 12", "fr": "ex. 12", "de": "z. B. 12", "es": "p. ej. 12" },
      "required": false
    },
    {
      "key": "planned_horizon_days",
      "type": "number",
      "label": {
        "en": "Planned works horizon (days)",
        "fr": "Horizon des travaux planifiés (jours)",
        "de": "Vorschau geplanter Arbeiten (Tage)",
        "es": "Horizonte de trabajos previstos (días)"
      },
      "description": {
        "en": "Planned works announced further ahead are ignored.",
        "fr": "Les travaux annoncés plus tard sont ignorés.",
        "de": "Später angekündigte Arbeiten werden ignoriert.",
        "es": "Los trabajos anunciados más adelante se ignoran."
      },
      "required": false,
      "default": 7,
      "min": 1,
      "max": 60
    },
    {
      "key": "poll_frequency",
      "type": "number",
      "label": {
        "en": "Refresh interval (s)",
        "fr": "Intervalle de rafraîchissement (s)",
        "de": "Aktualisierungsintervall (s)",
        "es": "Intervalo de actualización (s)"
      },
      "description": {
        "en": "How often the ORES outage map is read, in seconds (one minute minimum).",
        "fr": "Fréquence de lecture de la carte des pannes ORES, en secondes (une minute minimum).",
        "de": "Wie oft die ORES-Störungskarte gelesen wird, in Sekunden (mindestens eine Minute).",
        "es": "Frecuencia de lectura del mapa de averías de ORES, en segundos (un minuto como mínimo)."
      },
      "required": false,
      "default": 300,
      "min": 60,
      "max": 3600
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the ORES outage map",
        "fr": "Tester la carte des pannes ORES",
        "de": "ORES-Störungskarte testen",
        "es": "Probar el mapa de averías de ORES"
      },
      "timeout_seconds": 30
    }
  ],
